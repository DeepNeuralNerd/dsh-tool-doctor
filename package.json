{
  "name": "dsh-tool-doctor",
  "description": "Repair common DeepSeek Harness tool-call mistakes and review the results in a local dashboard.",
  "version": "1.2.0",
  "author": "DeepNeuralNerd",
  "homepage": "https://github.com/DeepNeuralNerd/dsh-tool-doctor#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeepNeuralNerd/dsh-tool-doctor.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tool-doctor",
    "tool-healer",
    "tool-normalizer",
    "error-recovery",
    "code-mode",
    "diagnostics"
  ],
  "license": "MIT",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.0"
  }
}
